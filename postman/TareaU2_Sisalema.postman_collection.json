    {
      "name": "07. Dishes - POST válido (201 + slug + virtual)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const num = Math.floor(10 + Math.random() * 89);",
              "pm.collectionVariables.set('dishCode', 'PLT-' + num);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Crear plato válido responde 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Genera slug con pre(validate) sin next', function () {",
              "    pm.expect(json.slug).to.eql('ceviche-de-camaron-costeno');",
              "});",
              "pm.test('Incluye virtual menuSummary y arreglos embebidos', function () {",
              "    pm.expect(json.menuSummary).to.include(pm.collectionVariables.get('dishCode'));",
              "    pm.expect(json.ingredients).to.be.an('array').with.lengthOf(4);",
              "    pm.expect(json.allergens).to.include('mariscos');",
              "});",
              "pm.collectionVariables.set('dishId', json._id);"
            ]
          }
        }
