# Copy as .env in the project root (do not commit .env to GitHub)
PORT=3005
NODE_ENV=development

# PostgreSQL (Prisma 7) - container espe-postgres
DATABASE_URL=postgresql://espe_user:espe_password@localhost:5432/espe_db?schema=public

# JWT
JWT_SECRET=change_this_secret

# MongoDB (Mongoose 9) - container espe-mongo
MONGODB_URI=mongodb://espe_user:espe_password@localhost:27017/espe_mongo?authSource=admin
